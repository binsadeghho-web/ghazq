# ==============================================================================
# پیکربندی متغیرهای محیطی سامانه جامع فقه و قضا (نسخه ۳.۰ معماری داده)
# راهنمای استقرار در هاست ابری رانفلر (Runflare Cloud)
# ==============================================================================

# ۱. تنظیمات سرور و محیط اجرا
NODE_ENV="production"
HOST="0.0.0.0"
PORT="3000"

# ۲. اتصال به پایگاه داده MySQL 8 رانفلر
# نکته: اگر وب‌سرویس و دیتابیس هر دو داخل پنل رانفلر شما هستند، از نام سرویس داخلی و پورت ۳۳۰۶ استفاده کنید (سریع‌تر و بدون خروج از شبکه ابری)
# اتصال داخلی ابری (پیش‌فرض تولید):
DB_HOST="ghzadatabase-xmm-service"
DB_PORT="3306"

# در صورت نیاز به اتصال مستقیم از خارج شبکه رانفلر:
# DB_HOST="remote-pishgaman.runflare.com"
# DB_PORT="31526"

DB_USER="root"
DB_PASSWORD="yeNn1HZfLMrkUa52lwHm"
DB_NAME="ghzadatafgd_db"

# ۳. دیسک ذخیره‌سازی ماندگار رانفلر (Persistent Volume Disk)
# این مسیر همان Mount Path دیسکی است که در رانفلر ایجاد کردید (/MYDISK)
# نرم‌افزار فایل‌های آپلود، پشتیبان‌های دیتابیس و زنجیره لاگ‌ها را در زیرپوشه‌های این دیسک ذخیره می‌کند:
# - /MYDISK/uploads  (فایل‌ها، فیش‌ها و مدارک)
# - /MYDISK/backups  (پشتیبان‌های خودکار دیتابیس)
# - /MYDISK/audit    (آرشیو لاگ‌های غیرقابل جعل)
STORAGE_PATH="/MYDISK"

# ۴. امنیت، توکن‌ها و کلیدهای رمزنگاری (اصل ۹ و ۱۰)
# کلید امنیتی برای مانیتورینگ عملکرد سامانه (/api/metrics)
METRICS_SECRET="ghaza_metrics_secret_key_9obe_2026"

# کلید HMAC برای مهر و موم زنجیره لاگ‌های حسابرسی (Tamper-Evident Audit Chain)
AUDIT_HMAC_KEY="ghaza_audit_hmac_master_key_secure_2026"

# ۵. کلید هوش مصنوعی (اختیاری در صورت فعال بودن بخش‌های تحلیل هوشمند)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
